{
  "name": "formatcase-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=@formatcase/web",
    "dev:ext": "npm run dev --workspace=@formatcase/extension",
    "build:web": "npm run build --workspace=@formatcase/web",
    "build:ext": "npm run build --workspace=@formatcase/extension",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run packages/core"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/chrome": "^0.0.304",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
